---
/* Sección de cotización. Se monta más de una vez en la landing con el mismo
   formulario del CRM (LeadConnector/GoHighLevel) embebido en cada una. El
   `data-form-id` identifica al formulario real y debe ser igual en todas las
   instancias; el id del iframe en cambio debe ser único por instancia, porque
   el auto-resize del widget hace el handshake por ese id (dos iframes con el
   mismo id se pisarían el uno al otro). Se deriva del `id` de la sección.
   Cada idioma tiene su propio formulario en el CRM (etiquetas traducidas allá). */
interface Props {
  /** Ancla de la sección y sufijo del id del iframe. */
  id: string;
  titulo: string;
  intro: string;
  lang?: 'es' | 'en';
}

import { withBase } from '../lib/url.js';

const { id, titulo, intro, lang = 'es' } = Astro.props;

const CRM_FORMS = {
  es: { id: 'IjKoqvBNilZMS77Dw4A1', name: 'Form_Landing TLE' },
  en: { id: 'Bo4A65ufceEQf2GV0liY', name: 'Form_Landing TLE - EN' },
};
const { id: CRM_FORM_ID, name: CRM_FORM_NAME } = CRM_FORMS[lang];
const iframeId = `inline-${CRM_FORM_ID}-${id}`;
---

  <section id={id} class="relative py-24 bg-tle-primary overflow-hidden">
    {/* Fondo: la flotilla en escala de grises, tenue bajo una capa del amarillo TLE. */}
    <img
      src={withBase('/images/bg_contacto.webp')}
      alt=""
      aria-hidden="true"
      loading="lazy"
      width="1400"
      height="840"
      class="absolute inset-0 w-full h-full object-cover grayscale opacity-30 pointer-events-none select-none"
    />
    <div class="absolute inset-0 bg-tle-primary/55" aria-hidden="true"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-tle-black mb-4 uppercase">{titulo}</h2>
        <p class="text-tle-black/70 text-sm max-w-2xl mx-auto leading-relaxed">{intro}</p>
      </div>

      <div data-reveal class="bg-tle-white p-4 sm:p-6 rounded-sm shadow-lg">
        <iframe
          src={`https://api.leadconnectorhq.com/widget/form/${CRM_FORM_ID}`}
          style="width:100%;height:884px;border:none;border-radius:8px"
          id={iframeId}
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name={CRM_FORM_NAME}
          data-height="884"
          data-layout-iframe-id={iframeId}
          data-form-id={CRM_FORM_ID}
          data-cookie-consent="true"
          data-cookie-consent-provider="auto"
          title={CRM_FORM_NAME}
        ></iframe>
      </div>
    </div>
  </section>
